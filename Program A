
import socket

# Sets the server IP address and port number between the two
HOST = '127.0.0.1'  # Localhost (same computer)
PORT = 45000

# Creates a TCP socket
client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

# Connects to Program B (the server)
client_socket.connect((HOST, PORT))

# Prompts the user to enter a message
message = input("Enter a message to send: ")

# Sends the message to Program B
client_socket.sendall(message.encode())

# Receives the response from Program B
response = client_socket.recv(1024)

# Converts the received bytes into a string and print it
print("Response from Program B:", response.decode())

# Closes the socket connection
client_socket.close()
